# --- Shared ---
DATABASE_URL=postgres://spendy:spendy@localhost:5433/spendy
# Shared secret both services check on their internal-only endpoints.
INTERNAL_SERVICE_TOKEN=dev-internal-token-change-me
# 32-byte key (base64) used for application-level AES-GCM encryption of stored PDFs.
# Generate with: openssl rand -base64 32
STORAGE_ENCRYPTION_KEY=

# --- Object storage (S3-compatible: MinIO locally, R2 in production) ---
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_REGION=auto
STORAGE_BUCKET=spendy-statements
STORAGE_ACCESS_KEY_ID=spendy
STORAGE_SECRET_ACCESS_KEY=spendy123
STORAGE_FORCE_PATH_STYLE=true

# --- Anthropic ---
# Only admin accounts process with this key; everyone else must add their own
# in the web app before anything is processed.
ANTHROPIC_API_KEY=
# Comma-separated admin emails (chike@toid.xyz is always an admin). Read by
# apps/api and services/telegram-bot.
ADMIN_EMAILS=

# --- apps/api (Hono) ---
PORT=8787
CLERK_SECRET_KEY=
CLERK_PUBLISHABLE_KEY=
PDF_SERVICE_URL=http://localhost:8000
PDF_SERVICE_TIMEOUT_MS=55000

# --- services/pdf-service (FastAPI) ---
PDF_SERVICE_PORT=8000
RETENTION_DAYS=30

# --- apps/web (Vite) ---
VITE_CLERK_PUBLISHABLE_KEY=
VITE_API_BASE_URL=http://localhost:8787
